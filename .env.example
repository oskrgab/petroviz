# Volve Explorer Environment Variables
#
# Every variable is optional. With no .env at all the app reads the Volve
# Dataset from where petrodb publishes it (the defaults shown below), so
# cloning and running is enough. Copy this file to .env only to override.
#
# petrodb publishes to two hosts:
#   - the Data host (Hugging Face) serves the parquet tables;
#   - the Schema host (the petrodb site) serves schema.json.
# Why two: https://github.com/oskrgab/petrodb/blob/main/docs/adr/0005-host-parquet-on-huggingface.md
#
# Values are inlined at build time: restart `pnpm run dev` or rebuild after a
# change. A missing or empty value falls back to the default.
#
# To see the resolved URLs, open the browser console and run: window.volveConfig()

# Data host: where the parquet tables are read from
PUBLIC_DATA_BASE_URL=https://huggingface.co/datasets/sumpalabs/petrodb/resolve/main

# Schema host: where schema.json is read from
PUBLIC_SCHEMA_BASE_URL=https://petrodb.ocortez.com

# Table paths, relative to the Data host, or absolute URLs
PUBLIC_WELLS_PARQUET=volve/wells.parquet
PUBLIC_DAILY_PRODUCTION_PARQUET=volve/daily_production.parquet
PUBLIC_MONTHLY_PRODUCTION_PARQUET=volve/monthly_production.parquet

# Schema path, relative to the Schema host, or an absolute URL
PUBLIC_SCHEMA_JSON=volve/schema.json

# To test data changes before petrodb publishes them, point both hosts at the
# homelab dev-petrodb, which serves the tables and the schema side by side:
# PUBLIC_DATA_BASE_URL=https://dev-petrodb.ocortez.com
# PUBLIC_SCHEMA_BASE_URL=https://dev-petrodb.ocortez.com
