# Volve Explorer Environment Variables
# Copy this file to .env and update with your values
#
# NOTE: If any variables are missing, the app will:
#   1. Use default values (shown below)
#   2. Display warnings in the browser console
#   3. Log which variables need configuration
#
# To check current config, open browser console and run: window.volveConfig()

# Base URL for the Volve database (parquet files, schema, etc.)
# This should point to your data hosting domain
PUBLIC_DATA_BASE_URL=https://volve-db.ocortez.com

# Parquet file paths (relative to base URL or full paths)
# Examples: "wells.parquet" or "data/wells.parquet"
PUBLIC_WELLS_PARQUET=wells.parquet
PUBLIC_DAILY_PRODUCTION_PARQUET=daily_production.parquet
PUBLIC_MONTHLY_PRODUCTION_PARQUET=monthly_production.parquet

# Schema file path (relative to base URL or full path)
PUBLIC_SCHEMA_JSON=schema.json
